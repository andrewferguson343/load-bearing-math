<Layouts.app flash={@flash}>
  <div class="r8-hero">
    <p class="r8-eyebrow">Rise8 Internal</p>
    <h1 class="r8-hero-title">Optimization Algorithms</h1>
    <p class="r8-hero-lede">
      Every system you'd call &ldquo;AI&rdquo; is, underneath, an optimization problem:
      a search for the inputs that minimize error or maximize reward. This is a
      hands-on walkthrough of the algorithms that make that search possible.
    </p>
    <div class="r8-hero-actions">
      <.link navigate={~p"/overview"} class="btn btn-primary">
        Start with the Overview <span aria-hidden="true">&rarr;</span>
      </.link>
    </div>
  </div>
</Layouts.app>
