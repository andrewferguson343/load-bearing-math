<Layouts.app flash={@flash}>
  <div class="lbm-hero">
    <h1 class="lbm-hero-title">Table of Contents</h1>
    <p class="lbm-hero-lede">
      Short, hands-on breakdowns of the math holding up everyday engineering. Pick a series below to
      start, new ones get added as they're ready.
    </p>
  </div>

  <section
    :for={{collection, topics} <- @groups}
    id={"topics-#{collection.slug}"}
    class="lbm-topic-group"
    aria-labelledby={"topics-#{collection.slug}-heading"}
  >
    <h2 id={"topics-#{collection.slug}-heading"} class="lbm-topic-group-title">
      <.link navigate={collection_path(collection)}>{collection.name}</.link>
    </h2>
    <div class="lbm-topic-index">
      <.topic_entry :for={topic <- topics} topic={topic} />
    </div>
  </section>

  <section :if={@ungrouped != []} id="topics-reference" class="lbm-topic-group">
    <h2 class="lbm-topic-group-title">Reference</h2>
    <div class="lbm-topic-index">
      <.topic_entry :for={topic <- @ungrouped} topic={topic} />
    </div>
  </section>

  <.link navigate="/sources" class="lbm-sources-link">Sources cited</.link>
</Layouts.app>
